<h1>Available Games</h1>

<ul>
  {% for item in collections.gamesList %}
    <li>
      <a href="{{ ('/games/' + item.game + '/') | url }}">{{ item.game | upper }}</a>
    </li>
  {% else %}
    <li>No games found in the database.</li>
  {% endfor %}
</ul>
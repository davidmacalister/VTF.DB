<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Texture Database") }}</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; background: #1a1a1a; color: #eee; }
        table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
        th, td { border: 1px solid #444; padding: 10px; text-align: left; vertical-align: top; }
        img { max-width: 200px; height: auto; display: block; margin-bottom: 5px; }
        a { color: #4db8ff; text-decoration: none; }
        a:hover { text-decoration: underline; }
        code { background: #333; padding: 2px 4px; font-size: 0.85em; word-break: break-all; }
    </style>
</head>
<body>
    <nav>
        <a href="{{ '/' | url }}">Home</a> |
        <a href="{{ '/games/' | url }}">Games</a> |
        <a href="{{ '/library/' | url }}">Libraries</a>
    </nav>
    <hr>
    
    {{ content | safe }}

</body>
</html>
---
pagination:
  data: collections.mapsList
  size: 1
  alias: mapItem
permalink: "/games/{{ mapItem.game }}/{{ mapItem.mapId }}/"
layout: layout.njk
---
<style>
  /* CSS Corrigido: Fiel à referência, sem contornos ou caixas de fundo na linha */
  .info-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .info-thumb {
    width: 32px;
    height: 32px;
    object-fit: cover;
    background-color: #333;
    /* Removido o border-radius para deixar os cantos vivos/quadrados */
  }
  .info-badge {
    background-color: #202430;
    color: #6392d8;
    padding: 4px 8px;
    border-radius: 4px; /* Leve arredondamento apenas no fundo azul do texto, como na referência */
    font-family: monospace;
    font-size: 0.9em;
    text-decoration: none;
  }
  a.info-badge:hover {
    background-color: #2a3040;
    color: #84aef0;
  }
  .info-text {
    color: #d19a66;
    font-size: 0.9em;
    font-family: sans-serif;
  }
</style>

<h1>{{ mapItem.mapData.title }}</h1>
<p>Game: {{ mapItem.game | upper }} | File: <code>{{ mapItem.mapData.filename }}</code></p>

<div style="background: #232; padding: 15px; margin-bottom: 20px; border-left: 4px solid #4caf50;">
  <p><strong>Sources found for {{ mapItem.stats.mapped }} of {{ mapItem.stats.total }} textures ({{ mapItem.stats.percentage }}%)</strong></p>
  <div style="height: 10px; background: #333;">
    <div style="height: 100%; width: {{ mapItem.stats.percentage }}%; background: #4caf50;"></div>
  </div>
</div>

{% if mapItem.mapData.cover_image %}
  <img src="{{ mapItem.mapData.cover_image | url }}" alt="Cover of {{ mapItem.mapData.title }}" style="max-width: 300px; margin-bottom: 20px;">
{% endif %}

{% if mapItem.descriptionHtml %}
  <div style="margin-bottom: 30px; line-height: 1.6; font-size: 1.05em; color: #ddd;">
    {{ mapItem.descriptionHtml | safe }}
  </div>
{% endif %}

{% for texturePath in mapItem.mapData.textures %}
  
  <h2>{{ texturePath.split('/') | last }}</h2>
  
  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th>Texture</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="vertical-align: top;">
          {% set manualImage = textureCatalog[texturePath] %}
          
          {% if manualImage %}
            <img src="{{ ('/img/tex/' + manualImage) | url }}" alt="Modified texture" style="max-width: 250px; margin-bottom: 10px;">
          {% else %}
            <div style="padding: 10px; border: 1px dashed red; margin-bottom: 5px;">
              🚫 Image not linked
            </div>
          {% endif %}
          
          <br><code>{{ texturePath }}</code>
        </td>

        <td style="vertical-align: top;">
          {% set foundOrigin = false %}
          
          {% for lib in collections.librariesList %}
            {% for img in lib.images %}
              {% if texturePath in img.imageData.derived_textures %}
                <img src="{{ ('/img/src/' + img.imageId + '.jpg') | url }}" alt="Source photo" style="max-width: 250px;">
                
                <div class="info-row">
                  {% if lib.cover %}
                    <img src="{{ lib.cover | url }}" alt="Library Cover" class="info-thumb">
                  {% else %}
                    <div class="info-thumb"></div>
                  {% endif %}
                  
                  <a href="{{ ('/library/' + (lib.libraryName | slugify) + '/') | url }}" class="info-badge">{{ lib.libraryName }}</a>
                  <span class="info-text">image:</span>
                  <span class="info-badge">{{ img.imageData.original_path.split('/') | last | default(img.imageId) }}</span>
                </div>

                {% set foundOrigin = true %}
              {% endif %}
            {% endfor %}
          {% endfor %}

          {% if not foundOrigin %}
            <em>No source mapped.</em>
          {% endif %}

          {% for contributor in mapItem.contributors %}
            {% if texturePath in contributor.textures %}
              <div style="margin-top: 10px; font-size: 0.9em; color: #888;">
                <strong>Found by:</strong> {{ contributor.name }}
              </div>
            {% endif %}
          {% endfor %}
        </td>
      </tr>
    </tbody>
  </table>
{% endfor %}

<section>
  <h2>Credits</h2>
  {% if mapItem.contributors | length %}
    {% for contributor in mapItem.contributors %}
      <h3>{{ contributor.name }}</h3>
      <ul>
        {% for texture in contributor.textures %}
          <li><code>{{ texture }}</code></li>
        {% endfor %}
      </ul>
    {% endfor %}
  {% else %}
    <p>No contributors credited yet.</p>
  {% endif %}
</section>

<section>
  <h2>References</h2>
  {% if referencesData | length %}
    <ol>
      {% for reference in referencesData %}
        <li><a href="{{ reference.url }}">{{ reference.title }}</a></li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No references added yet.</p>
  {% endif %}
</section>
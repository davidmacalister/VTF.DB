---
pagination:
  data: collections.mapsList
  size: 1
  alias: mapItem
permalink: "/games/{{ mapItem.game }}/{{ mapItem.mapId }}/"
layout: layout.njk
---
<h1>{{ mapItem.mapData.title }}</h1>
<p>Game: {{ mapItem.game | upper }} | File: <code>{{ mapItem.mapData.filename }}</code></p>

<div style="background: #232; padding: 15px; margin-bottom: 20px; border-left: 4px solid #4caf50;">
  <p><strong>Sources found for {{ mapItem.stats.mapped }} of {{ mapItem.stats.total }} textures ({{ mapItem.stats.percentage }}%)</strong></p>
  <div style="height: 10px; background: #333;">
    <div style="height: 100%; width: {{ mapItem.stats.percentage }}%; background: #4caf50;"></div>
  </div>
</div>

<img src="{{ mapItem.mapData.cover_image }}" alt="Capa de {{ mapItem.mapData.title }}">

{% for texturePath in mapItem.mapData.textures %}
  
  <h2>{{ texturePath.split('/') | last }}</h2>
  
  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th>Texture</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          {% set manualImage = textureCatalog[texturePath] %}
          
          {% if manualImage %}
            <img src="/img/{{ manualImage }}" alt="Modified texture">
          {% else %}
            <div style="padding: 10px; border: 1px dashed red; margin-bottom: 5px;">
              🚫 Image not linked
            </div>
          {% endif %}
          
          <code>{{ texturePath }}</code>
        </td>

        <td>
          {% set foundOrigin = false %}
          
          {% for lib in collections.librariesList %}
            {% for img in lib.images %}
              {% if texturePath in img.imageData.derived_textures %}
                <img src="/img/{{ img.imageId }}.jpg" alt="Source photo">
                <code>{{ img.imageData.original_path }}</code><br>
                <a href="/library/{{ lib.libraryName | slugify }}/">{{ lib.libraryName }}</a>
                {% set foundOrigin = true %}
              {% endif %}
            {% endfor %}
          {% endfor %}

          {% if not foundOrigin %}
            <em>No source mapped.</em>
          {% endif %}

          {% for contributor in mapItem.contributors %}
            {% if texturePath in contributor.textures %}
              <br><strong>Found by:</strong> {{ contributor.name }}
            {% endif %}
          {% endfor %}
        </td>
      </tr>
    </tbody>
  </table>
{% endfor %}

<section>
  <h2>Credits</h2>
  {% if mapItem.contributors | length %}
    {% for contributor in mapItem.contributors %}
      <h3>{{ contributor.name }}</h3>
      <ul>
        {% for texture in contributor.textures %}
          <li><code>{{ texture }}</code></li>
        {% endfor %}
      </ul>
    {% endfor %}
  {% else %}
    <p>No contributors credited yet.</p>
  {% endif %}
</section>

<section>
  <h2>References</h2>
  {% if creditsData.references | length %}
    <ol>
      {% for reference in creditsData.references %}
        <li><a href="{{ reference.url }}">{{ reference.title }}</a></li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No references added yet.</p>
  {% endif %}
</section>
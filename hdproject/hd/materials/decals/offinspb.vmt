LightmappedGeneric
{
	"$basetexture"	"decals\offinspb"
	"$translucent" "1"
	"$decal" "1"
	"$decalscale" "0.2"
	"$envmap" "environment maps\cs_office"
	"$envmapmask" "decals\offinspb_ref"
	"$surfaceprop" "glass"

	"$texscale" "2"
    "$baseTextureOffset" "[0.5 0.5]"
	
"Proxies"

      {
       "TextureTransform"
       {
    "translateVar" "$baseTextureOffset"
    "scaleVar"     "$texscale"
    "resultVar"    "$baseTextureTransform"
            }
      }

}
}
